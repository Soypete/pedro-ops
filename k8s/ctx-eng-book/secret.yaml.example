# Do not commit real values. Create the Secret from ctx-eng-book's
# git-ignored .env instead:
#   kubectl create secret generic ctx-eng-book-secrets -n ctx-eng-book \
#     --from-env-file=$HOME/Code/misc/ctx-eng-book/.env
apiVersion: v1
kind: Secret
metadata:
  name: ctx-eng-book-secrets
  namespace: ctx-eng-book
type: Opaque
stringData:
  SUBSTACK_SESSION_COOKIE: "<substack.sid cookie from a logged-in browser>"
  DISCORD_SECRET: "<OpenBao secret/pedro/discord, field token>"
  DISCORD_USER_ID: "<numeric Discord user ID to mention>"
