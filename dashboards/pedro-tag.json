{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Pedro Tag — Service Overview",
  "uid": "pedro-tag-overview",
  "tags": ["pedro", "pedro-tag"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource_prom",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "datasource_loki",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "targets": [
        { "refId": "A", "expr": "up{job=\"pedro-tag\"}", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } }
      ]
    },
    {
      "type": "stat",
      "title": "Request rate (req/s)",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=\"pedro-tag\"}[5m]))", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx %)",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 2,
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] }
        }
      },
      "targets": [
        { "refId": "A", "expr": "100 * sum(rate(http_requests_total{job=\"pedro-tag\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"pedro-tag\"}[5m])), 1)", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"pedro-tag\"}[5m])) by (le))", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by handler",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "sum by (handler) (rate(http_requests_total{job=\"pedro-tag\"}[5m]))", "legendFormat": "{{handler}}", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"pedro-tag\"}[5m])) by (le))", "legendFormat": "p50", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"pedro-tag\"}[5m])) by (le))", "legendFormat": "p95", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"pedro-tag\"}[5m])) by (le))", "legendFormat": "p99", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prom}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_requests_total{job=\"pedro-tag\"}[5m]))", "legendFormat": "{{status}}", "datasource": { "type": "prometheus", "uid": "${datasource_prom}" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (count_over_time({namespace=\"pedrotag\"} | json | level != `` [1m]))", "legendFormat": "{{level}}", "datasource": { "type": "loki", "uid": "${datasource_loki}" } }
      ]
    },
    {
      "type": "logs",
      "title": "Logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none", "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{namespace=\"pedrotag\"} | json | line_format `{{.level}} {{.logger}} {{.message}}`", "datasource": { "type": "loki", "uid": "${datasource_loki}" } }
      ]
    }
  ]
}
